#!/usr/bin/env bash
set -euo pipefail

PROVIDER_RUNTIME="${BACKS_AIOS_PROVIDER_RUNTIME:-$HOME/.local/share/backs-aios/provider-control/current}"
PROJECT_FILE="$HOME/.config/backs-aios/provider-control/project-root"

if [[ ! -L "$PROVIDER_RUNTIME" ]]; then
  printf 'ERROR: %s is not an updateable provider-control symlink.\n' "$PROVIDER_RUNTIME" >&2
  exit 1
fi

SOURCE="$(readlink "$PROVIDER_RUNTIME")"
if [[ "$SOURCE" != /* ]]; then
  SOURCE="$(cd "$(dirname "$PROVIDER_RUNTIME")" && cd "$SOURCE" && pwd -P)"
fi

if [[ ! -d "$SOURCE/.git" ]]; then
  printf 'ERROR: provider-control source is not a git checkout: %s\n' "$SOURCE" >&2
  exit 1
fi

if [[ -n "$(git -C "$SOURCE" status --porcelain --untracked-files=no)" ]]; then
  printf 'ERROR: provider-control source has tracked local changes; refusing to overwrite them.\n' >&2
  printf 'Run git -C "%s" status --short to inspect them.\n' "$SOURCE" >&2
  exit 1
fi

BRANCH="${BACKS_AIOS_CHANNEL:-main}"

git -C "$SOURCE" fetch --prune origin "$BRANCH"
git -C "$SOURCE" merge --ff-only "origin/$BRANCH"

PROJECT_ROOT=""
if [[ -r "$PROJECT_FILE" ]]; then
  IFS= read -r PROJECT_ROOT < "$PROJECT_FILE" || true
fi

if [[ -n "$PROJECT_ROOT" && -d "$PROJECT_ROOT" ]]; then
  bash "$SOURCE/install-provider.sh" "$PROJECT_ROOT"
else
  bash "$SOURCE/install-provider.sh"
fi

python3 -m unittest discover -s "$SOURCE/tests" -p 'test_provider_control.py' -q
python3 -m unittest discover -s "$SOURCE/tests" -p 'test_provider_public_safety.py' -q

printf '\nBACKS provider control updated successfully.\n'
printf 'Branch : %s\n' "$BRANCH"
printf 'Commit : %s\n' "$(git -C "$SOURCE" rev-parse --short HEAD)"
printf 'Main BACKS runtime was not modified.\n'
