#!/usr/bin/env bash
# Compare private BACKS skill coverage to this public pack without disclosing
# private names, paths, descriptions, or bodies. Publishing uses only a
# separately authored public bridge file; the private source is never copied.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ "$SCRIPT_DIR" == */skills/backs-pack-sync/scripts ]]; then
  ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd -P)"
  SCRUBBER="$ROOT/skills/scrub-plugin-pack-literals/scripts/scrub-plugin-pack-literals"
else
  ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
  SCRUBBER="$ROOT/bin/scrub-plugin-pack-literals"
fi
PLUGIN_SKILLS="$ROOT/skills"
PUBLIC_BRIDGES="$ROOT/public-bridges"
BACKS_SOURCE="${BACKS_SOURCE:-}"

fail() { printf 'FATAL: %s\n' "$1" >&2; exit 1; }

case "${1:-}" in
  "")
    [[ -n "$BACKS_SOURCE" && -d "$BACKS_SOURCE/skills" ]] ||
      fail 'Set BACKS_SOURCE to a readable runtime tree before comparing coverage.'
    missing=0
    while IFS= read -r -d '' skill; do
      name="$(basename "$(dirname "$skill")")"
      [[ -f "$PLUGIN_SKILLS/$name/SKILL.md" ]] || missing=$((missing + 1))
    done < <(find "$BACKS_SOURCE/skills" -mindepth 2 -maxdepth 2 -name SKILL.md -print0)
    printf 'Private-only skill count: %d (names and source path withheld).\n' "$missing"
    printf 'Publish only a separately authored file under public-bridges/<name>/SKILL.md.\n'
    ;;

  --bridge)
    [[ $# -eq 2 ]] || fail 'Usage: backs-pack-sync --bridge <public-name>'
    name="$2"
    [[ "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail 'Invalid public skill name.'
    src="$PUBLIC_BRIDGES/$name/SKILL.md"
    dst_dir="$PLUGIN_SKILLS/$name"
    dst="$dst_dir/SKILL.md"
    [[ -d "$PUBLIC_BRIDGES" && ! -L "$PUBLIC_BRIDGES" &&
       -d "$PUBLIC_BRIDGES/$name" && ! -L "$PUBLIC_BRIDGES/$name" &&
       -f "$src" && ! -L "$src" ]] ||
      fail 'No separately authored public bridge exists for that name.'
    [[ ! -e "$dst_dir" && ! -L "$dst_dir" ]] || fail 'Public skill already exists.'
    # Never read or copy a private runtime body to make a public bridge.
    grep -Eq "^name:[[:space:]]*\\\"?$name\\\"?[[:space:]]*$" "$src" ||
      fail 'Public bridge frontmatter name does not match.'
    if grep -Eiq '(/home/[[:alnum:]_.-]+|/mnt/[[:alnum:]_.-]+|/opt/[[:alnum:]_.-]+|[[:alpha:]]:[/\\]|(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.)[0-9.]+|[[:alnum:]_.%+-]+@[[:alnum:].-]+\.[[:alpha:]]{2,})' "$src"; then
      fail 'Public bridge failed the private literal preflight.'
    fi
    mkdir "$dst_dir"
    # The existing scrubber treats Windows CRLF as a rewrite. Normalize the
    # curated text once, before the guard; this changes no words or metadata.
    tr -d '\r' < "$src" > "$dst"
    if ! bash "$SCRUBBER" --hook >/dev/null 2>&1; then
      rm -f -- "$dst"
      rmdir -- "$dst_dir"
      fail 'Public bridge failed the pack hygiene guard.'
    fi
    printf 'One curated public skill bridged. Run the full public hygiene suite before release.\n'
    ;;

  --bridge-all-missing)
    fail 'Bulk bridging private runtime skills into a public pack is disabled.'
    ;;

  *)
    fail 'Usage: backs-pack-sync [--bridge <public-name>]'
    ;;
esac
