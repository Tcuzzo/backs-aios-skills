#!/usr/bin/env bash
# reload-vsc-and-verify
# Forces the VS Code Claude Code extension to re-scan ~/.claude/skills/
# after the AIOS plugin pack adds new skills. Bridges two real-world
# topologies so this command works whichever install mode is in play:
#
#   topology A: ~/.claude/skills is itself a symlink to the plugin pack
#               (one symlink; all new skills are visible immediately)
#   topology B: ~/.claude/skills is a real directory of per-file symlinks
#               pointing at the plugin pack (install.sh --target claude);
#               new skills need an explicit symlink before VS Code sees them
#   topology C: ~/.claude/skills is missing entirely (no install yet)
#
# The script detects which topology is live, fixes the gap if B, then
# reloads the VS Code window.
#
# Usage: bash ~/backs-aios-skills/bin/reload-vsc-and-verify

set -euo pipefail

PLUGIN_ROOT="$HOME/backs-aios-skills"
CLAUDE_SKILLS="$HOME/.claude/skills"

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
cyan()  { printf '\033[36m%s\033[0m\n' "$*"; }
yel()   { printf '\033[33m%s\033[0m\n' "$*"; }
bold()  { printf '\033[1m%s\033[0m\n' "$*"; }

cyan "=== STEP 1: plugin pack on disk ==="
[[ -d "$PLUGIN_ROOT" ]] || { red "FATAL: $PLUGIN_ROOT missing"; exit 1; }
git -C "$PLUGIN_ROOT" rev-parse --is-inside-work-tree >/dev/null
green "  plugin pack: $PLUGIN_ROOT"
printf '  HEAD:        %s\n' "$(git -C "$PLUGIN_ROOT" rev-parse --short HEAD)"
printf '  version:     %s\n' "$(jq -r .version "$PLUGIN_ROOT/.claude-plugin/plugin.json")"

cyan "=== STEP 2: ~/.claude/skills topology ==="
topology="missing"
if [[ -L "$CLAUDE_SKILLS" ]]; then
  topology="single-symlink"
  green "  A: ~/.claude/skills -> $(readlink -f "$CLAUDE_SKILLS")"
elif [[ -d "$CLAUDE_SKILLS" ]]; then
  topology="per-file-symlinks"
  green "  B: ~/.claude/skills is a real directory (per-file symlinks)"
else
  red "  C: ~/.claude/skills MISSING"
  yel "     fix with: bash $PLUGIN_ROOT/install.sh --target claude"
  exit 1
fi

cyan "=== STEP 3: bridge new skills (topology B only) ==="
# In topology B, install.sh created one symlink per skill at install time.
# New skills added to the plugin pack after install are invisible until
# each gets its own symlink. Close that gap here.
linked=0
if [[ "$topology" == "per-file-symlinks" ]]; then
  for skill_dir in "$PLUGIN_ROOT"/skills/*/; do
    [[ -f "$skill_dir/SKILL.md" ]] || continue
    s="$(basename "$skill_dir")"
    dst="$CLAUDE_SKILLS/$s"
    if [[ ! -e "$dst" ]]; then
      ln -s "$skill_dir" "$dst"
      green "  linked: $dst -> $skill_dir"
      linked=$((linked + 1))
    fi
  done
  if (( linked == 0 )); then
    green "  no missing links — every plugin pack skill is already wired"
  else
    bold "  bridged $linked new skill(s) into ~/.claude/skills/"
  fi
else
  green "  n/a — single-symlink topology auto-propagates"
fi

cyan "=== STEP 4: reload VS Code window ==="
if command -v code >/dev/null 2>&1; then
  bold "  issuing: code --command workbench.action.reloadWindow"
  code --command workbench.action.reloadWindow >/dev/null 2>&1 || true
  green "  reload command issued. VS Code re-scans in ~2s."
else
  yel "  'code' CLI not on PATH in this shell."
  yel "  From VS Code Command Palette (Ctrl+Shift+P), run:"
  bold "      > Developer: Reload Window"
fi

cyan "=== STEP 5: live verification ==="
bold "  After reload, try any of these in the VS Code chat:"
CO_FAMILY=(conscientious-objector osha-bot co-health)
for s in "${CO_FAMILY[@]}"; do
  printf '    /%-26s  -> %s/%s/SKILL.md\n' "$s" "$CLAUDE_SKILLS" "$s"
done
bold "  All three resolve (not 'unknown skill') = LIVE LOAD OK."
