{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/aios_gate.js\""
      }
    ],
    "postToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/aios_gate.js\"",
        "matcher": "Skill"
      }
    ],
    "preToolUse": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/hooks/aios_gate.js\"",
        "matcher": "Shell|Write|Delete"
      }
    ]
  }
}
